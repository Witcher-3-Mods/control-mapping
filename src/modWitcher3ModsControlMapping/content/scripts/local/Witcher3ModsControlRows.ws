function Witcher3ModsPadGroup() : name
{
    return 'Witcher3ModsPadInput';
}

function Witcher3ModsStoreGroup() : name
{
    return 'Witcher3ModsPadStore';
}

function Witcher3ModsStoreCount() : int
{
    return 58;
}

function Witcher3ModsModVersion() : string
{
    return "2.0";
}

function Witcher3ModsPadLayoutCount() : int
{
    return 5;
}

function Witcher3ModsPadLayoutName(Witcher3ModsLayout : int) : string
{
    switch (Witcher3ModsLayout)
    {
        case 0: return "Exploration";
        case 1: return "Swimming";
        case 2: return "Combat";
        case 3: return "Horse";
        case 4: return "Boat";
    }
    return "?";
}

// Pad key number (EInputKey) back to the enum value; IK_None when the number is not a known pad button.
function Witcher3ModsPadKeyFromInt(Witcher3ModsKey : int) : EInputKey
{
    if (Witcher3ModsKey == (int)IK_Pad_A_CROSS) return IK_Pad_A_CROSS;
    if (Witcher3ModsKey == (int)IK_Pad_B_CIRCLE) return IK_Pad_B_CIRCLE;
    if (Witcher3ModsKey == (int)IK_Pad_X_SQUARE) return IK_Pad_X_SQUARE;
    if (Witcher3ModsKey == (int)IK_Pad_Y_TRIANGLE) return IK_Pad_Y_TRIANGLE;
    if (Witcher3ModsKey == (int)IK_Pad_LeftShoulder) return IK_Pad_LeftShoulder;
    if (Witcher3ModsKey == (int)IK_Pad_RightShoulder) return IK_Pad_RightShoulder;
    if (Witcher3ModsKey == (int)IK_Pad_LeftTrigger) return IK_Pad_LeftTrigger;
    if (Witcher3ModsKey == (int)IK_Pad_RightTrigger) return IK_Pad_RightTrigger;
    if (Witcher3ModsKey == (int)IK_Pad_LeftThumb) return IK_Pad_LeftThumb;
    if (Witcher3ModsKey == (int)IK_Pad_RightThumb) return IK_Pad_RightThumb;
    if (Witcher3ModsKey == (int)IK_Pad_DigitUp) return IK_Pad_DigitUp;
    if (Witcher3ModsKey == (int)IK_Pad_DigitDown) return IK_Pad_DigitDown;
    if (Witcher3ModsKey == (int)IK_Pad_DigitLeft) return IK_Pad_DigitLeft;
    if (Witcher3ModsKey == (int)IK_Pad_DigitRight) return IK_Pad_DigitRight;
    if (Witcher3ModsKey == (int)IK_Pad_Start) return IK_Pad_Start;
    if (Witcher3ModsKey == (int)IK_Pad_Back_Select) return IK_Pad_Back_Select;
    return IK_None;
}

function Witcher3ModsPadRowCount(Witcher3ModsLayout : int) : int
{
    switch (Witcher3ModsLayout)
    {
        case 0: return 20;
        case 1: return 12;
        case 2: return 17;
        case 3: return 17;
        case 4: return 12;
    }
    return 0;
}

