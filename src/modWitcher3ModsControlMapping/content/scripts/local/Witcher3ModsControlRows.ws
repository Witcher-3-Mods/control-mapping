        case 'W3MCtxHorseSilver': Witcher3ModsLayout = 3; Witcher3ModsVar = 'W3MPadSilver'; return true;
        case 'W3MCtxHorsePotion1': Witcher3ModsLayout = 3; Witcher3ModsVar = 'W3MPadPotion1'; return true;
        case 'W3MCtxHorsePotion2': Witcher3ModsLayout = 3; Witcher3ModsVar = 'W3MPadPotion2'; return true;
        case 'W3MCtxBoatAccelerate': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadAccelerate'; return true;
        case 'W3MCtxBoatDecelerate': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadDecelerate'; return true;
        case 'W3MCtxBoatBoatDismount': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadBoatDismount'; return true;
        case 'W3MCtxBoatVehicleItem': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadVehicleItem'; return true;
        case 'W3MCtxBoatFocus': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadFocus'; return true;
        case 'W3MCtxBoatRadial': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadRadial'; return true;
        case 'W3MCtxBoatChangeQuest': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadChangeQuest'; return true;
        case 'W3MCtxBoatCameraLock': Witcher3ModsLayout = 4; Witcher3ModsVar = 'W3MPadCameraLock'; return true;
    }
    return false;
}

function Witcher3ModsPadIsVar(Witcher3ModsVar : name) : bool
{
    switch (Witcher3ModsVar)
    {
        case 'W3MPadInteract': return true;
        case 'W3MPadSprint': return true;
        case 'W3MPadSprintToggle': return true;
        case 'W3MPadJump': return true;
        case 'W3MPadFastAttack': return true;
        case 'W3MPadStrongAttack': return true;
        case 'W3MPadCastSign': return true;
        case 'W3MPadQuickItem': return true;
        case 'W3MPadFocus': return true;
        case 'W3MPadGuard': return true;
        case 'W3MPadRadial': return true;
        case 'W3MPadSummonHorse': return true;
        case 'W3MPadChangeQuest': return true;
        case 'W3MPadCameraLock': return true;
        case 'W3MPadSteel': return true;
        case 'W3MPadSilver': return true;
        case 'W3MPadPotion1': return true;
        case 'W3MPadPotion2': return true;
        case 'W3MPadDodge': return true;
        case 'W3MPadRoll': return true;
        case 'W3MPadDiveDown': return true;
        case 'W3MPadDiveUp': return true;
        case 'W3MPadGallop': return true;
        case 'W3MPadHorseJump': return true;
        case 'W3MPadDismount': return true;
        case 'W3MPadBoatDismount': return true;
        case 'W3MPadVehicleAttack': return true;
        case 'W3MPadVehicleSign': return true;
        case 'W3MPadVehicleItem': return true;
        case 'W3MPadAccelerate': return true;
        case 'W3MPadDecelerate': return true;
    }
    return false;
}
