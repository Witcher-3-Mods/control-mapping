// Row tag sent by Flash (a stored-key id) back to its layout and group variable.
function Witcher3ModsStoreLookup(Witcher3ModsStore : name, out Witcher3ModsLayout : int, out Witcher3ModsVar : name) : bool
{
    Witcher3ModsLayout = -1;
    Witcher3ModsVar = '';
    switch (Witcher3ModsStore)
    {
        case 'W3MCtxExplorationInteract': Witcher3ModsLayout = 0; Witcher3ModsVar = 'W3MPadInteract'; return true;
        case 'W3MCtxExplorationSprint': Witcher3ModsLayout = 0; Witcher3ModsVar = 'W3MPadSprint'; return true;
        case 'W3MCtxExplorationJump': Witcher3ModsLayout = 0; Witcher3ModsVar = 'W3MPadJump'; return true;
